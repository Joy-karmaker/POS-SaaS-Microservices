// Prisma schema for Tenant Databases (orders + payments live in the per-tenant DB)

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model Order {
  id     Int    @id @default(autoincrement())
  status String @default("PENDING")

  @@map("orders")
}

model Payment {
  id              BigInt   @id @default(autoincrement())
  order_id        Int      @map("order_id")
  method          String
  amount          Decimal  @db.Decimal(12, 2)
  status          String   @default("PENDING")
  idempotency_key String?  @map("idempotency_key") @db.VarChar(255)
  gateway_ref     String?  @map("gateway_ref") @db.VarChar(255)
  created_at      DateTime @default(now()) @map("created_at")
  updated_at      DateTime @updatedAt @map("updated_at")

  @@unique([idempotency_key])
  @@index([order_id])
  @@map("payments")
}
